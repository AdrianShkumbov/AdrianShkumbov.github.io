---
// src/components/CodeSnippet.astro
import { Code } from 'astro:components';

interface Props {
  code: string;
  lang: string;
  title?: string;
  theme?: string; 
}

// Switched to a softer, lower-contrast dark theme
const { code, lang, title, theme = "github-dark-dimmed" } = Astro.props;
---

<div class="not-prose my-8 w-full rounded-xl border-2 border-slate-600 shadow-inner overflow-hidden bg-slate-800">
  
  {/* Header bar using a deeper, semi-transparent slate */}
  <div class="bg-slate-900/50 px-4 py-2 border-b border-slate-700">
    <span class="text-xs font-mono font-semibold text-slate-300">
      {title || lang}
    </span>
  </div>

  {/* The syntax-highlighted code */}
  <div class="p-4 overflow-x-auto text-sm font-mono [&>pre]:!bg-transparent text-slate-200">
    <Code code={code} lang={lang as any} theme={theme as any} />
  </div>
</div>