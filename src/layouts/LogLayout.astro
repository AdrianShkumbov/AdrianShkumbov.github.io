---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;

// Mock navigation items - in a real scenario, you can extract these from MDX headers
const sections = [
  { id: 'overview', label: 'SYSTEM_OVERVIEW' },
  { id: 'hardware', label: 'HARDWARE_DESIGN' },
  { id: 'control', label: 'CONTROL_LOGIC' },
  { id: 'integration', label: 'INTEGRATION_LOGS' },
];
---

<BaseLayout title={frontmatter.title}>
  <div class="max-w-7xl mx-auto px-6 py-12 flex flex-col md:flex-row gap-12">
    
    <aside class="md:w-64 flex-shrink-0">
      <div class="sticky top-24 space-y-8">
        <div>
          <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">Project_Modules</h3>
          <ul class="space-y-3 border-l border-slate-200 ml-1">
            {sections.map(section => (
              <li>
                <a href={`#${section.id}`} class="block pl-4 -ml-px border-l-2 border-transparent hover:border-blue-500 text-slate-500 hover:text-blue-600 text-sm font-medium transition-all uppercase tracking-tighter">
                  {section.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="p-4 bg-slate-100 rounded-lg border border-slate-200">
          <h4 class="text-[10px] font-bold text-slate-500 uppercase mb-2">Technical_Specs</h4>
          <ul class="text-[11px] font-mono text-slate-600 space-y-1">
            <li>OS: Ubuntu 22.04</li>
            <li>Tools: SOLIDWORKS</li>
            <li>Logic: C++, PID</li>
          </ul>
        </div>
      </div>
    </aside>

    <main class="flex-grow">
      <header class="mb-12">
        <div class="flex gap-2 mb-4">
          {frontmatter.tags?.map(tag => (
            <span class="px-2 py-1 bg-blue-50 text-blue-700 text-[10px] font-bold rounded uppercase tracking-wider border border-blue-100">
              {tag}
            </span>
          ))}
        </div>
        <h1 class="text-5xl font-black text-slate-900 mb-4 tracking-tighter italic uppercase leading-none">
          {frontmatter.title}
        </h1>
        <p class="text-xl text-slate-600 font-light max-w-2xl">
          {frontmatter.description}
        </p>
      </header>

      <div class="prose-engineering">
        <slot />
      </div>
    </main>
  </div>
</BaseLayout>