---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title}>
  <div class="max-w-6xl mx-auto px-6 py-12 flex flex-col md:flex-row gap-12">
    
    <aside class="md:w-64 flex-shrink-0">
      <div class="sticky top-36 space-y-8">
        <div>
          <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">Chapters</h3>
          <ul id="dynamic-sidebar" class="space-y-3 border-l border-slate-200 ml-1">
             </ul>
        </div>
      </div>
    </aside>

    <main class="flex-grow">
      <header class="mb-12">
        <div class="flex gap-2 mb-4">
          {frontmatter.tags?.map(tag => (
            <span class="px-2 py-1 bg-blue-50 text-blue-700 text-[10px] font-bold rounded uppercase tracking-wider border border-blue-100">
              {tag}
            </span>
          ))}
        </div>
        <h1 class="text-5xl font-black text-slate-900 mb-4 tracking-tighter italic uppercase leading-none">
          {frontmatter.title}
        </h1>
        <p class="text-xl text-slate-600 font-light max-w-2xl">
          {frontmatter.description}
        </p>
      </header>

      <div class="prose-engineering">
        <slot />
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  function generateSidebar() {
    // Find all h2 tags inside the main content area and convert them to an array
    const allHeadings = Array.from(document.querySelectorAll('.prose-engineering h2'));
    
    // Filter out any headings that sit inside the .not-prose container (TLDR bubble, etc.)
    const headings = allHeadings.filter(h2 => !h2.closest('.not-prose'));
    
    const sidebar = document.getElementById('dynamic-sidebar');

    if (!sidebar) return;

    // Clear it out
    sidebar.innerHTML = '';

    headings.forEach((h2) => {
      // Auto-generate an ID if one doesn't exist
      if (!h2.id) {
        h2.id = h2.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      }

      // Create the list item and link
      const li = document.createElement('li');
      li.innerHTML = `
        <a 
          href="#${h2.id}" 
          class="block pl-4 -ml-px border-l-2 border-transparent hover:border-blue-500 text-slate-500 hover:text-blue-600 text-sm font-medium transition-all uppercase tracking-tighter"
        >
          ${h2.textContent}
        </a>
      `;
      
      sidebar.appendChild(li);
    });
  }

  // Run the function when the page loads
  document.addEventListener('DOMContentLoaded', generateSidebar);
</script>