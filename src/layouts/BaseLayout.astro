---
import '../styles/global.css';
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Adrian Shkumbov</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css">
  </head>
  <body class="bg-slate-50 text-slate-900 selection:bg-blue-100">
    <nav class="sticky top-0 z-40 w-full backdrop-blur-md bg-blue-50 border-b border-slate-200">
      <div class="max-w-6xl mx-auto px-6 h-24 flex items-center justify-between">
        
        <a href="/" class="inline-block font-bold text-5xl tracking-tighter italic text-amber-500 [text-shadow:2px_2px_0_var(--color-amber-600),4px_4px_0_var(--color-blue-300),5px_5px_0_var(--color-blue-300)]">
          ADRIAN SHKUMBOV
        </a>
        
        <div class="flex gap-8 text-md font-bold tracking-widest text-slate-500 uppercase">
          <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
          <a href="/projects" class="hover:text-blue-600 transition-colors">Projects</a>
        </div>
        
      </div>
    </nav>
    <slot />
    <footer class="py-12 border-t border-slate-200 mt-20 text-center text-slate-500 text-sm">
      <p>&copy; 2026 Adrian Shkumbov</p>
    </footer>
  </body>
</html>