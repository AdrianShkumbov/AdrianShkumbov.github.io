---
import '../styles/global.css';
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Robotics Engineer</title>
  </head>
  <body class="bg-slate-50 text-slate-900 selection:bg-blue-100">
    <nav class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/75 border-b border-slate-200">
      <div class="max-w-6xl mx-auto px-6 h-24 flex items-center justify-between">
        
        <a href="/" class="font-black text-3xl tracking-tighter hover:text-blue-600 transition-colors">
          ADRIAN SHKUMBOV
        </a>
        
        <div class="flex gap-8 text-sm font-bold tracking-widest text-slate-500 uppercase">
          <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
          <a href="/projects" class="hover:text-blue-600 transition-colors">Projects</a>
          <a href="/experience" class="hover:text-blue-600 transition-colors">Experience</a>
        </div>
        
      </div>
    </nav>
    <slot />
    <footer class="py-12 border-t border-slate-200 mt-20 text-center text-slate-500 text-sm">
      <p>&copy; 2026 Adrian Shkumbov</p>
    </footer>
  </body>
</html>