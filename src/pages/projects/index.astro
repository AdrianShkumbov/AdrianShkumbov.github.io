---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allProjects = await getCollection('logs');
const sortedProjects = allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Projects">
  <main class="max-w-4xl mx-auto px-6 py-16">
    <header class="mb-16">
      <h1 class="text-5xl font-black text-slate-900 mb-4 tracking-tighter">PROJECT_ARCHIVE</h1>
      <p class="text-lg text-slate-500 font-mono tracking-tight">Accessing system-level integration logs...</p>
    </header>

    <div class="grid gap-8">
      {sortedProjects.map((project, index) => (
        <a href={`/projects/${project.id}`} class="group p-8 bg-white border border-slate-200 rounded-2xl hover:border-blue-500 hover:shadow-sm transition-all flex flex-col">
          
          <div class="flex justify-between items-start mb-4 gap-4">
            <time class="text-xs font-mono text-blue-600 block tracking-widest pt-1">{project.data.date.toLocaleDateString()}</time>
            
            <span class="text-4xl font-black text-slate-200 italic tracking-tighter group-hover:text-blue-200 transition-colors flex-shrink-0 leading-none">
              #{String(index + 1).padStart(2, '0')}
            </span>
          </div>
          
          <h2 class="text-3xl font-bold text-slate-900 mb-4 tracking-tight group-hover:translate-x-2 transition-transform">{project.data.title}</h2>
          <p class="text-slate-600 max-w-2xl mb-6">{project.data.description}</p>
          
          <div class="flex gap-2 flex-wrap">
            {project.data.tags?.map(tag => (
              <span class="px-3 py-1 bg-slate-100 text-slate-500 text-[10px] font-bold rounded-full uppercase tracking-widest">
                {tag}
              </span>
            ))}
          </div>
          
        </a>
      ))}
    </div>
  </main>
</BaseLayout>