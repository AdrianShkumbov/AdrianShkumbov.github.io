---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

// Import the project icons
import iconCr from '../../assets/project_icons/cr.png';
import iconDatboi from '../../assets/project_icons/datboi.jpg';
import iconEmg from '../../assets/project_icons/emg.png';

const allProjects = await getCollection('logs');

// Parse the dates to ensure they subtract as valid numbers (newest first)
const sortedProjects = allProjects.sort((a, b) => 
  new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

function formatYearMonth(date) {
  const d = new Date(date);
  return `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}`;
}

// Map the project filenames (IDs) to their respective icons
const iconMap = {
  'thesis': iconCr,
  'unicycle_bot': iconDatboi,
  'emg_viz': iconEmg
};
---

<BaseLayout title="Projects">
  <main class="max-w-4xl mx-auto px-6 py-16">
    <header class="mb-16">
      <h1 class="text-4xl font-black text-slate-900 mb-4 tracking-tighter italic">PROJECT_ARCHIVE</h1>
      <p class="text-lg text-slate-500 font-mono tracking-tight">Peep the stuff...</p>
    </header>

    <div class="grid gap-8">
      {sortedProjects.map((project) => (
        <a href={`/projects/${project.id}`} class="group p-8 bg-white border border-slate-200 rounded-2xl hover:border-blue-500 hover:shadow-sm transition-all flex flex-col">
          
          <div class="flex justify-between items-start gap-6 mb-4">
            
            <!-- Group the date and title on the left -->
            <div class="flex flex-col">
              <time class="text-xs font-mono text-blue-600 block tracking-widest mb-3">{formatYearMonth(project.data.date)}</time>
              <h2 class="text-3xl font-bold text-slate-900 tracking-tight group-hover:translate-x-2 transition-transform">{project.data.title}</h2>
            </div>
            
            <!-- Icon rendering block pushed to the right, increased in size -->
            {iconMap[project.id] ? (
              <Image 
                src={iconMap[project.id]} 
                alt={`${project.data.title} icon`}
                class="w-24 h-24 sm:w-28 sm:h-28 object-cover rounded-xl border-2 border-slate-100 shadow-sm transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-3 group-hover:border-blue-200 flex-shrink-0"
              />
            ) : (
              <!-- Fallback placeholder -->
              <div class="w-24 h-24 sm:w-28 sm:h-28 bg-slate-100 rounded-xl border-2 border-slate-200 flex-shrink-0"></div>
            )}
            
          </div>
          
          <p class="text-slate-600 max-w-2xl mb-6">{project.data.description}</p>
          
          <div class="flex gap-2 flex-wrap">
            {project.data.tags?.map(tag => (
              <span class="px-3 py-1 bg-slate-100 text-slate-500 text-[10px] font-bold rounded-full uppercase tracking-widest">
                {tag}
              </span>
            ))}
          </div>
          
        </a>
      ))}
    </div>
  </main>
</BaseLayout>