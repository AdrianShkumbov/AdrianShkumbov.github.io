---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allProjects = await getCollection('logs');
const sortedProjects = allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Projects">
  <main class="max-w-4xl mx-auto px-6 py-16">
    <header class="mb-16">
      <h1 class="text-5xl font-black text-slate-900 mb-4 tracking-tighter">PROJECT_ARCHIVE</h1>
      <p class="text-lg text-slate-500 font-mono tracking-tight">Accessing system-level integration logs...</p>
    </header>

    <div class="grid gap-8">
      {sortedProjects.map(project => (
        <a href={`/projects/${project.id}`} class="group relative p-8 bg-white border border-slate-200 rounded-2xl hover:border-blue-500 transition-all overflow-hidden">
          <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-100 transition-opacity">
             <span class="text-6xl font-black italic">#0{sortedProjects.indexOf(project) + 1}</span>
          </div>
          <div class="relative z-10">
            <time class="text-xs font-mono text-blue-600 mb-2 block tracking-widest">{project.data.date.toLocaleDateString()}</time>
            <h2 class="text-3xl font-bold text-slate-900 mb-4 tracking-tight group-hover:translate-x-2 transition-transform">{project.data.title}</h2>
            <p class="text-slate-600 max-w-2xl mb-6">{project.data.description}</p>
            <div class="flex gap-2">
              {project.data.tags?.map(tag => (
                <span class="px-3 py-1 bg-slate-100 text-slate-500 text-[10px] font-bold rounded-full uppercase tracking-widest">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>