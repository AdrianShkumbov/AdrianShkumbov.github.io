---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
  <main class="max-w-4xl mx-auto px-6 py-20">
    <section class="mb-24">
      <h2 class="text-xs font-bold text-blue-600 uppercase tracking-[0.2em] mb-4">System_Status: Active</h2>
      <h1 class="text-6xl font-black text-slate-900 mb-8 tracking-tighter italic">
        ROBOTICS_ENGINEER
      </h1>
      <div class="prose-engineering text-lg text-slate-600 leading-relaxed">
        <p>
          I am an engineer specializing in <strong>robotics and system integration</strong>[cite: 4]. 
          My work focuses on bridging the gap between mechanical design and control theory to create 
          machines that perform like well-oiled systems[cite: 4, 5].
        </p>
        <p>
          Currently, I am focused on multidisciplinary engineering challenges—ranging from 
          <strong>CAD design in SOLIDWORKS</strong> to implementing <strong>PID control loops</strong> 
          and <strong>Kalman filters</strong> for autonomous systems[cite: 5, 30, 32].
        </p>
      </div>
    </section>

    <section class="p-8 bg-slate-900 rounded-2xl text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-2xl">
      <div>
        <h3 class="text-2xl font-bold mb-2 tracking-tight">Technical_Credentials.pdf</h3>
        <p class="text-slate-400 font-mono text-sm">Size: 1.2MB | Format: LaTeX PDF</p>
      </div>
      <a 
        href="/resume.pdf" 
        download 
        class="px-8 py-4 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-lg transition-all transform hover:scale-105 flex items-center gap-2"
      >
        <span>DOWNLOAD RESUME</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </section>
  </main>
</BaseLayout>